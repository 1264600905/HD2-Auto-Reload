+++ b/tests/test_visibility.lua
@@ -0,0 +1,44 @@
+-- Conditional rows follow pending/applied toggles and retain hidden values.
+local source=arg[1] or 'src/mod_options_menu.lua'
+local root=source:match('^(.*)[/\\]src[/\\][^/\\]+$') or '.'
+local Text=dofile(root..'/src/bingus_text.lua')
+_G.mom_text={module=Text,locales={en=dofile(root..'/locales/en.lua'),bundled={}}}
+_G.mom_files=setmetatable({}, {__index=function(files,name)
+    local chunk=assert(loadfile(root..'/src/'..name..'.lua'));rawset(files,name,chunk);return chunk
+end})
+_G.ModOptionsMenu,_G.update,_G.BingusTranslations,_G.BingusRuntime=nil,function() end,nil,nil
+_G.CowboyBingusModLoader={log_directory=(os.getenv('TEMP') or '.')..'/mom-visibility-no-folder'}
+dofile(source)
+local function upvalue(fn,name)
+    for i=1,80 do local key,value=debug.getupvalue(fn,i)
+        if key==name then return value end;if not key then break end
+    end
+    error('missing upvalue '..name)
+end
+local menu=assert(ModOptionsMenu)
+local state=upvalue(menu.register_option,'state')
+local step=upvalue(update,'step')
+local mom=upvalue(upvalue(upvalue(step,'maintain_view'),'build_page'),'mom')
+assert(menu.version==4 and menu.conditional_options)
+assert(menu.register_option('visibility.parent',{type='toggle',label='Parent',mod='Visibility',default=false}))
+local spec={type='choice',label='Child',mod='Visibility',choices={'One','Two'},default=2,visible_if='visibility.parent'}
+assert(menu.register_option('visibility.child',spec))
+assert(not mom.option_visible(state.options['visibility.child']) and menu.get('visibility.child')==2)
+local revision=state.revision
+mom.set_pending('visibility.parent',true)
+assert(state.revision>revision and mom.option_visible(state.options['visibility.child']))
+assert(menu.get('visibility.parent')==false)
+mom.drop_pending()
+assert(not mom.option_visible(state.options['visibility.child']) and menu.get('visibility.child')==2)
+assert(menu.set('visibility.parent',true) and mom.option_visible(state.options['visibility.child']))
+mom.set_pending('visibility.child',1);mom.set_pending('visibility.parent',false)
+assert(not mom.option_visible(state.options['visibility.child']))
+mom.apply_pending()
+assert(menu.get('visibility.child')==1 and menu.get('visibility.parent')==false)
+assert(menu.set('visibility.parent',true) and mom.option_visible(state.options['visibility.child']))
+assert(menu.get('visibility.child')==1)
+spec.visible_if='visibility.other'
+assert(not menu.register_option('visibility.child',spec))
+spec.visible_if='visibility.child'
+assert(not menu.register_option('visibility.child',spec))
+print('PASS conditional rows follow pending, discard, apply and set; hidden values survive')
